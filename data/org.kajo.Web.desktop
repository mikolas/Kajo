[Desktop Entry]
Name=Kajo Web
Comment=Lightweight Hardware-Accelerated Aero + Metro Web Browser for the Kajo Desktop
Exec=kajo-web %U
Icon=kajo-web
Terminal=false
Type=Application
Categories=Network;WebBrowser;
