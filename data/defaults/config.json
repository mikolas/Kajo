{
  "panel": {
    "position": "bottom",
    "height": 39,
    "layer": "top",
    "widget_mode": "icon",
    "icon_size": 24,
    "touch_gestures": {
      "enabled": true,
      "dwell_ms": 4000,
      "swipe_center": "launcher",
      "swipe_right": "control-center",
      "swipe_horizontal": "column",
      "osk_auto_show_mode": "tablet",
      "osk_push_windows": true,
      "osk_height_px": 260
    }
  },
  "autohide": {
    "enabled": true,
    "reveal_delay": 200,
    "hide_delay": 1000,
    "reveal_duration": 150,
    "hide_duration": 200
  },
  "notifications": {
    "toast_timeout_ms": 8000,
    "max_notification_history": 50,
    "toast_click_action": "focus",
    "dnd_enabled": false
  },
  "mod": {
    "filter_mode": "a500",
    "led_mode": "auto",
    "sid_model": "auto",
    "stereo_sep_pct": 70,
    "end_action": "next-sub",
    "hvsc_path": "",
    "uade_timeout_sec": 180,
    "auto_extract_archives": true
  },
  "idle": {
    "screensaver_mode": "overlay",
    "screensaver_timeout_sec": 300,
    "dpms_timeout_sec": 600,
    "lock_timeout_sec": 900,
    "lock_on_suspend": true
  },
  "layout": {
    "left": [
      "launcher",
      "workspaces",
      {"id": "window", "mode": "full"}
    ],
    "center": [
      {"id": "clock", "mode": "label"}
    ],
    "right": [
      "tray",
      {"id": "notifications", "mode": "icon"},
      {"id": "media", "mode": "icon"},
      {"id": "network", "mode": "icon"},
      {"id": "bluetooth", "mode": "icon"},
      {"id": "cpu-mem", "mode": "icon"},
      {"id": "keyboard-layout", "mode": "label"},
      {"id": "osk", "mode": "icon"},
      {"id": "volume", "mode": "icon"},
      {"id": "battery", "mode": "icon"},
      {"id": "privacy", "mode": "icon"},
      {"id": "theme", "mode": "icon"},
      {"id": "custom-script", "mode": "icon"},
      {"id": "control-center", "mode": "icon"},
      {"id": "power", "mode": "icon"}
    ]
  }
}
