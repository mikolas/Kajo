[Unit]
Description=Portal service (Kajo Files FileChooser implementation)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.kajo.Files
Environment="GDK_DEBUG=no-portals" "GIO_USE_PORTALS=0"
ExecStart=@BINDIR@/kajo-files --portal
Slice=session.slice
