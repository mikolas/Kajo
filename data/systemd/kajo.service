[Unit]
Description=Kajo Desktop Shell & Panel
PartOf=graphical-session.target
BindsTo=kajo-comp.service
After=kajo-comp.service graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Slice=session.slice
Type=simple
ExecStart=/usr/bin/kajo
Restart=on-failure
RestartSec=1

[Install]
WantedBy=kajo-comp.service
