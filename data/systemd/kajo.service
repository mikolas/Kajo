[Unit]
Description=Kajo Desktop Shell & Panel
PartOf=graphical-session.target
BindsTo=kajo-comp.service
After=kajo-comp.service graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Slice=session.slice
Type=simple
Environment="GDK_DEBUG=no-portals" "GIO_USE_PORTALS=0"
ExecStart=/usr/bin/kajo
KillMode=process
Restart=on-failure
RestartSec=1

[Install]
WantedBy=kajo-comp.service
