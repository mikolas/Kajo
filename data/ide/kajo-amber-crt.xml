<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="kajo-amber-crt" name="Amber Phosphor CRT" version="1.0">
  <author>Kajo Desktop Suite</author>
  <description>Retro Monochrome Amber Phosphor CRT Terminal Syntax Scheme for kajo-ide</description>

  <color name="canvas_bg"       value="#0c0900"/>
  <color name="gutter_bg"       value="#100c00"/>
  <color name="current_line"    value="#1a1300"/>
  <color name="selection_bg"    value="#4d3600"/>
  <color name="border_gray"     value="#332400"/>
  <color name="fg_primary"      value="#ffb000"/>
  <color name="fg_muted"        value="#7a5400"/>
  <color name="metro_accent"    value="#ffd700"/>
  <color name="metro_warning"   value="#ff8c00"/>
  <color name="metro_urgent"    value="#ff3b00"/>

  <color name="syn_keyword"     value="#ffd700"/>
  <color name="syn_control"     value="#ffcc33"/>
  <color name="syn_function"    value="#ffe066"/>
  <color name="syn_type"        value="#ff9900"/>
  <color name="syn_string"      value="#ff8000"/>
  <color name="syn_number"      value="#ffc233"/>
  <color name="syn_comment"     value="#8c6200"/>

  <style name="text"                        foreground="fg_primary" background="canvas_bg"/>
  <style name="selection"                   foreground="#ffffff"    background="selection_bg"/>
  <style name="cursor"                      foreground="#ffd700"/>
  <style name="current-line"                background="current_line"/>
  <style name="current-line-number"         foreground="metro_accent" background="current_line" bold="true"/>
  <style name="line-numbers"                foreground="fg_muted"   background="gutter_bg"/>
  <style name="right-margin"                foreground="border_gray" background="gutter_bg"/>
  <style name="bracket-match"               foreground="#0c0900"    background="#ffd700" bold="true"/>
  <style name="bracket-mismatch"            foreground="#ffffff"    background="metro_urgent" bold="true"/>
  <style name="search-match"                foreground="#0c0900"    background="metro_accent" bold="true"/>

  <style name="def:comment"                 foreground="syn_comment" italic="true"/>
  <style name="def:shebang"                 foreground="syn_comment" bold="true"/>
  <style name="def:doc-comment-element"     foreground="#b37d00" italic="true"/>
  <style name="def:constant"                foreground="syn_number"/>
  <style name="def:number"                  foreground="syn_number"/>
  <style name="def:floating-point"          foreground="syn_number"/>
  <style name="def:boolean"                 foreground="syn_keyword" bold="true"/>
  <style name="def:string"                  foreground="syn_string"/>
  <style name="def:character"               foreground="syn_string"/>
  <style name="def:special-char"            foreground="metro_accent"/>
  <style name="def:identifier"              foreground="fg_primary"/>
  <style name="def:function"                foreground="syn_function" bold="true"/>
  <style name="def:builtin"                 foreground="syn_function"/>
  <style name="def:statement"               foreground="syn_control" bold="true"/>
  <style name="def:keyword"                 foreground="syn_keyword" bold="true"/>
  <style name="def:operator"                foreground="#ffb000"/>
  <style name="def:type"                    foreground="syn_type"/>
  <style name="def:preprocessor"            foreground="metro_accent" bold="true"/>
  <style name="def:error"                   foreground="#ffffff" background="metro_urgent" bold="true"/>
  <style name="def:warning"                 foreground="#0c0900" background="metro_warning"/>
  <style name="def:note"                    foreground="#0c0900" background="metro_accent" bold="true"/>
  <style name="def:heading"                 foreground="metro_accent" bold="true"/>
  <style name="def:link-text"               foreground="metro_accent" underline="single"/>
</style-scheme>
