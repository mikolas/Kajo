<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="kajo-metro-dark" name="Kajo Metro Dark" version="1.0">
  <author>Kajo Desktop Suite</author>
  <description>Aero + Metro OLED Dark Syntax Scheme for kajo-ide</description>

  <!-- Palette -->
  <color name="canvas_bg"       value="#101010"/>
  <color name="gutter_bg"       value="#121212"/>
  <color name="current_line"    value="#171717"/>
  <color name="selection_bg"    value="#004578"/>
  <color name="border_gray"     value="#2b2b2b"/>
  <color name="fg_primary"      value="#e6e6e6"/>
  <color name="fg_muted"        value="#666666"/>
  <color name="metro_accent"    value="#0078d4"/>
  <color name="metro_telemetry" value="#00d8f0"/>
  <color name="metro_warning"   value="#ff8c00"/>
  <color name="metro_urgent"    value="#e81123"/>
  <color name="metro_success"   value="#10893e"/>

  <color name="syn_keyword"     value="#569cd6"/>
  <color name="syn_control"     value="#c586c0"/>
  <color name="syn_function"    value="#dcdcaa"/>
  <color name="syn_type"        value="#4ec9b0"/>
  <color name="syn_string"      value="#ce9178"/>
  <color name="syn_number"      value="#b5cea8"/>
  <color name="syn_comment"     value="#6a9955"/>

  <!-- Global Editor Styles -->
  <style name="text"                        foreground="fg_primary" background="canvas_bg"/>
  <style name="selection"                   foreground="#ffffff"    background="selection_bg"/>
  <style name="cursor"                      foreground="#ffffff"/>
  <style name="current-line"                background="current_line"/>
  <style name="current-line-number"         foreground="metro_accent" background="current_line" bold="true"/>
  <style name="line-numbers"                foreground="fg_muted"   background="gutter_bg"/>
  <style name="right-margin"                foreground="border_gray" background="gutter_bg"/>
  <style name="bracket-match"               foreground="#ffffff"    background="#264f78" bold="true"/>
  <style name="bracket-mismatch"            foreground="#ffffff"    background="metro_urgent" bold="true"/>
  <style name="search-match"                foreground="#000000"    background="metro_warning" bold="true"/>

  <!-- Syntax Highlighting -->
  <style name="def:comment"                 foreground="syn_comment" italic="true"/>
  <style name="def:shebang"                 foreground="syn_comment" bold="true"/>
  <style name="def:doc-comment-element"     foreground="#88b872" italic="true"/>
  <style name="def:constant"                foreground="syn_number"/>
  <style name="def:number"                  foreground="syn_number"/>
  <style name="def:floating-point"          foreground="syn_number"/>
  <style name="def:boolean"                 foreground="syn_keyword" bold="true"/>
  <style name="def:string"                  foreground="syn_string"/>
  <style name="def:character"               foreground="syn_string"/>
  <style name="def:special-char"            foreground="metro_telemetry"/>
  <style name="def:identifier"              foreground="fg_primary"/>
  <style name="def:function"                foreground="syn_function"/>
  <style name="def:builtin"                 foreground="syn_function"/>
  <style name="def:statement"               foreground="syn_control" bold="true"/>
  <style name="def:keyword"                 foreground="syn_keyword" bold="true"/>
  <style name="def:operator"                foreground="#d4d4d4"/>
  <style name="def:type"                    foreground="syn_type"/>
  <style name="def:preprocessor"            foreground="metro_telemetry"/>
  <style name="def:error"                   foreground="#ffffff" background="metro_urgent" bold="true"/>
  <style name="def:warning"                 foreground="#000000" background="metro_warning"/>
  <style name="def:note"                    foreground="#000000" background="metro_telemetry" bold="true"/>
  <style name="def:heading"                 foreground="metro_accent" bold="true"/>
  <style name="def:link-text"               foreground="metro_telemetry" underline="single"/>
</style-scheme>
