<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="kajo-nord-frost" name="Nord Frost" version="1.0">
  <author>Kajo Desktop Suite</author>
  <description>Arctic Nord Frost Dark Syntax Scheme for kajo-ide</description>

  <color name="canvas_bg"       value="#14171d"/>
  <color name="gutter_bg"       value="#171b22"/>
  <color name="current_line"    value="#1d222b"/>
  <color name="selection_bg"    value="#2e3b4e"/>
  <color name="border_gray"     value="#2b303c"/>
  <color name="fg_primary"      value="#eceff4"/>
  <color name="fg_muted"        value="#616e88"/>
  <color name="metro_accent"    value="#88c0d0"/>
  <color name="metro_warning"   value="#ebcb8b"/>
  <color name="metro_urgent"    value="#bf616a"/>

  <color name="syn_keyword"     value="#81a1c1"/>
  <color name="syn_control"     value="#81a1c1"/>
  <color name="syn_function"    value="#88c0d0"/>
  <color name="syn_type"        value="#8fbcbb"/>
  <color name="syn_string"      value="#a3be8c"/>
  <color name="syn_number"      value="#b48ead"/>
  <color name="syn_comment"     value="#616e88"/>

  <style name="text"                        foreground="fg_primary" background="canvas_bg"/>
  <style name="selection"                   foreground="#ffffff"    background="selection_bg"/>
  <style name="cursor"                      foreground="#88c0d0"/>
  <style name="current-line"                background="current_line"/>
  <style name="current-line-number"         foreground="metro_accent" background="current_line" bold="true"/>
  <style name="line-numbers"                foreground="fg_muted"   background="gutter_bg"/>
  <style name="right-margin"                foreground="border_gray" background="gutter_bg"/>
  <style name="bracket-match"               foreground="#14171d"    background="#88c0d0" bold="true"/>
  <style name="bracket-mismatch"            foreground="#ffffff"    background="metro_urgent" bold="true"/>
  <style name="search-match"                foreground="#14171d"    background="metro_warning" bold="true"/>

  <style name="def:comment"                 foreground="syn_comment" italic="true"/>
  <style name="def:shebang"                 foreground="syn_comment" bold="true"/>
  <style name="def:doc-comment-element"     foreground="#8fbcbb" italic="true"/>
  <style name="def:constant"                foreground="syn_number"/>
  <style name="def:number"                  foreground="syn_number"/>
  <style name="def:floating-point"          foreground="syn_number"/>
  <style name="def:boolean"                 foreground="syn_keyword" bold="true"/>
  <style name="def:string"                  foreground="syn_string"/>
  <style name="def:character"               foreground="syn_string"/>
  <style name="def:special-char"            foreground="#ebcb8b"/>
  <style name="def:identifier"              foreground="#d8dee9"/>
  <style name="def:function"                foreground="syn_function"/>
  <style name="def:builtin"                 foreground="syn_function"/>
  <style name="def:statement"               foreground="syn_control" bold="true"/>
  <style name="def:keyword"                 foreground="syn_keyword" bold="true"/>
  <style name="def:operator"                foreground="#81a1c1"/>
  <style name="def:type"                    foreground="syn_type"/>
  <style name="def:preprocessor"            foreground="#5e81ac" bold="true"/>
  <style name="def:error"                   foreground="#ffffff" background="metro_urgent" bold="true"/>
  <style name="def:warning"                 foreground="#14171d" background="metro_warning"/>
  <style name="def:note"                    foreground="#14171d" background="metro_accent" bold="true"/>
  <style name="def:heading"                 foreground="metro_accent" bold="true"/>
  <style name="def:link-text"               foreground="metro_accent" underline="single"/>
</style-scheme>
