[Desktop Entry]
Type=Application
Name=Kajo Files
GenericName=File Manager
Comment=Browse local and remote filesystems with Quick Look preview
Exec=kajo-files %U
Icon=system-file-manager
Terminal=false
Categories=System;FileTools;FileManager;Utility;
MimeType=inode/directory;
StartupWMClass=org.kajo.Files
Keywords=files;folders;explorer;browser;gvfs;smb;sftp;trash;
