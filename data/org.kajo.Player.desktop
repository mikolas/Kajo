[Desktop Entry]
Name=Kajo Player
Comment=Wayland Media Player for the Kajo Desktop
Exec=kajo-player %U
Icon=kajo-player
Terminal=false
Type=Application
Categories=AudioVideo;Video;Audio;Player;GTK;
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/vnd.avi;video/mpeg;video/mp2t;video/ogg;video/x-ogm+ogg;video/x-flv;video/x-ms-wmv;video/x-ms-asf;video/3gpp;video/3gpp2;video/dv;audio/mpeg;audio/mp3;audio/x-mp3;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/x-opus+ogg;audio/wav;audio/x-wav;audio/vnd.wave;audio/mp4;audio/x-m4a;audio/aac;audio/x-aac;audio/webm;audio/x-matroska;audio/x-ms-wma;audio/x-ape;audio/x-wavpack;application/ogg;
StartupNotify=true
StartupWMClass=org.kajo.Player
Keywords=video;movie;player;media;mkv;mp4;audio;kajo;
