using Gtk 4.0;

template $ShellThemePopover : Popover {
  styles [
    "shell-popover",
  ]

  Box {
    orientation: vertical;

    styles [
      "popover-medium",
    ]

    /* Zone 1: Header (Title + Status Badge) */
    Box {
      orientation: horizontal;
      valign: center;

      styles [
        "shell-popover-header",
      ]

      Label title_label {
        label: "ACCENT COLORS";
        xalign: 0;
        hexpand: true;
        valign: center;

        styles [
          "shell-popover-title",
        ]
      }

      Label status_badge {
        label: "[ #0078D4 ]";
        valign: center;

        styles [
          "shell-popover-badge",
        ]
      }
    }

    /* Zone 2: Body (Accent Color Grid) */
    Box {
      orientation: vertical;
      spacing: 8;

      styles [
        "shell-popover-body",
      ]

      Grid preset_grid {
        column-spacing: 8;
        row-spacing: 8;
        column-homogeneous: true;
        row-homogeneous: true;
      }
    }

    /* Zone 3: Footer (Settings Link) */
    Box {
      orientation: horizontal;
      spacing: 8;
      valign: center;

      styles [
        "shell-popover-footer",
      ]

      Button settings_btn {
        label: "THEME & TYPOGRAPHY SETTINGS";
        has-frame: false;
        halign: end;
        valign: center;
        hexpand: true;
      }
    }
  }
}
