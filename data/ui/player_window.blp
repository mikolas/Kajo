using Gtk 4.0;

template $KajoPlayerWindow : ApplicationWindow {
  title: "KAJO PLAYER";
  default-width: 980;
  default-height: 620;
  decorated: false;

  styles [
    "shell-settings-window",
    "shell-files-window",
    "shell-player-window",
  ]

  Overlay root_overlay {
    hexpand: true;
    vexpand: true;

    /* Base Layer: Video Stage + Optional Queue Drawer */
    Box body_hbox {
      orientation: horizontal;
      spacing: 0;
      hexpand: true;
      vexpand: true;

      Overlay video_overlay {
        hexpand: true;
        vexpand: true;

        GLArea video_gl_area {
          hexpand: true;
          vexpand: true;
          auto-render: false;

          styles [
            "player-video-stage",
          ]
        }

        [overlay]
        Box empty_state_box {
          orientation: vertical;
          spacing: 12;
          halign: center;
          valign: center;

          Image {
            icon-name: "video-x-generic";
            pixel-size: 64;
          }

          Label {
            label: "NO MEDIA LOADED";

            styles [
              "heading",
            ]
          }

          Label {
            label: "Open a video or audio file (.mkv, .mp4, .webm, .mp3, .flac) to begin playback";

            styles [
              "shell-popover-subtitle",
            ]
          }

          Button btn_empty_open {
            label: "📂 OPEN MEDIA FILE (CTRL+O)";
            halign: center;

            styles [
              "files-accent-btn",
            ]
          }
        }

        [overlay]
        Box audio_state_box {
          orientation: vertical;
          spacing: 14;
          halign: center;
          valign: center;
          visible: false;

          styles [
            "shell-popover-card",
            "player-audio-card",
          ]

          Image {
            icon-name: "audio-x-generic";
            pixel-size: 72;
          }

          Label audio_title_label {
            label: "Audio Stream";
            wrap: true;
            max-width-chars: 42;
            justify: center;

            styles [
              "heading",
            ]
          }

          Label audio_meta_label {
            label: "AUDIO STREAM";

            styles [
              "shell-popover-badge",
            ]
          }
        }
      }

      /* Right Toggleable Queue Drawer (230px, Hidden by Default) */
      Box queue_vbox {
        orientation: vertical;
        spacing: 0;
        width-request: 230;
        visible: false;

        styles [
          "files-inspector-pane",
        ]

        Box {
          orientation: vertical;
          spacing: 0;
          vexpand: true;
          margin-start: 6;
          margin-end: 6;
          margin-top: 6;
          margin-bottom: 6;

          styles [
            "shell-popover-card",
          ]

          Box {
            orientation: horizontal;
            spacing: 6;

            styles [
              "shell-popover-header",
            ]

            Label {
              label: "QUEUE";
              halign: start;

              styles [
                "heading",
              ]
            }

            Label queue_count_badge {
              label: "[ 0 ]";
              hexpand: true;
              halign: end;

              styles [
                "shell-popover-badge",
              ]
            }
          }

          ScrolledWindow {
            vexpand: true;
            hscrollbar-policy: never;
            vscrollbar-policy: automatic;

            ListBox queue_listbox {
              selection-mode: single;

              styles [
                "navigation-sidebar",
              ]
            }
          }
        }
      }
    }

    /* Overlay Zone 1: Frameless Metro Header Deck (Top) */
    [overlay]
    WindowHandle header_handle {
      valign: start;
      hexpand: true;

      Box header_bar {
        orientation: horizontal;
        spacing: 10;

        styles [
          "settings-header-bar",
          "player-header-bar",
        ]

        Label title_label {
          label: "🎬 KAJO PLAYER";
          halign: start;
          ellipsize: middle;
          valign: center;

          styles [
            "settings-header-title",
          ]
        }

        Label stream_badge {
          label: "[ IDLE ]";
          hexpand: true;
          halign: end;
          valign: center;

          styles [
            "shell-popover-badge",
          ]
        }

        Button btn_open {
          label: "📂 OPEN";
          tooltip-text: "Open Media File (Ctrl+O)";
          valign: center;

          styles [
            "flat",
            "files-nav-btn",
          ]
        }

        Button btn_queue {
          label: "☰ QUEUE";
          tooltip-text: "Toggle Queue Drawer (Ctrl+P)";
          valign: center;

          styles [
            "flat",
            "files-nav-btn",
          ]
        }

        Button btn_float {
          label: "🗗 FLOAT / TILE";
          valign: center;

          styles [
            "flat",
          ]
        }

        Button btn_close {
          label: "✕";
          valign: center;

          styles [
            "settings-close-btn",
          ]
        }
      }
    }

    /* Overlay Zone 2: Bottom Metro Transport Deck */
    [overlay]
    Box transport_deck {
      orientation: vertical;
      spacing: 6;
      valign: end;
      hexpand: true;

      styles [
        "player-transport-deck",
      ]

      /* Row 1: Timeline Scrubber & Timecode */
      Box {
        orientation: horizontal;
        spacing: 10;
        valign: center;

        Label time_elapsed_lbl {
          label: "00:00";
          valign: center;

          styles [
            "player-timecode",
          ]
        }

        Scale seek_scale {
          orientation: horizontal;
          hexpand: true;
          draw-value: false;
          valign: center;

          styles [
            "player-seek-scale",
          ]
        }

        Label time_total_lbl {
          label: "00:00";
          valign: center;

          styles [
            "player-timecode",
          ]
        }
      }

      /* Row 2: Transport Buttons & Volume / Fullscreen */
      Box {
        orientation: horizontal;
        spacing: 8;
        valign: center;

        Button btn_prev {
          label: "⏮";
          tooltip-text: "Previous in Queue (PageUp)";
          valign: center;

          styles [
            "flat",
            "files-nav-btn",
          ]
        }

        Button btn_seek_back {
          label: "-10s";
          tooltip-text: "Rewind 10 Seconds (Left)";
          valign: center;

          styles [
            "flat",
            "files-nav-btn",
          ]
        }

        Button btn_play_pause {
          label: "▶ PLAY";
          tooltip-text: "Play / Pause (Space)";
          valign: center;

          styles [
            "files-accent-btn",
            "player-play-btn",
          ]
        }

        Button btn_seek_fwd {
          label: "+10s";
          tooltip-text: "Fast-Forward 10 Seconds (Right)";
          valign: center;

          styles [
            "flat",
            "files-nav-btn",
          ]
        }

        Button btn_next {
          label: "⏭";
          tooltip-text: "Next in Queue (PageDown)";
          valign: center;

          styles [
            "flat",
            "files-nav-btn",
          ]
        }

        Button btn_loop {
          label: "🔁 LOOP";
          tooltip-text: "Toggle Loop Current Track (L)";
          valign: center;

          styles [
            "flat",
            "files-nav-btn",
          ]
        }

        Label transport_status_lbl {
          label: "READY";
          hexpand: true;
          halign: center;
          valign: center;
          ellipsize: end;

          styles [
            "shell-popover-subtitle",
          ]
        }

        Button btn_mute {
          label: "🔊";
          tooltip-text: "Toggle Mute (M)";
          valign: center;

          styles [
            "flat",
            "files-nav-btn",
          ]
        }

        Scale volume_scale {
          orientation: horizontal;
          width-request: 96;
          draw-value: false;
          valign: center;

          styles [
            "player-volume-scale",
          ]
        }

        Label volume_pct_lbl {
          label: "100%";
          width-request: 42;
          halign: end;
          valign: center;

          styles [
            "player-timecode",
          ]
        }

        Button btn_fullscreen {
          label: "⛶ FULL";
          tooltip-text: "Toggle Fullscreen (F / Double-Click)";
          valign: center;

          styles [
            "flat",
            "files-nav-btn",
          ]
        }
      }
    }
  }
}
