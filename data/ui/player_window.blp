using Gtk 4.0;

template $KajoPlayerWindow : ApplicationWindow {
  title: "KAJO PLAYER";
  default-width: 1040;
  default-height: 640;
  decorated: false;

  styles [
    "shell-settings-window",
    "shell-files-window",
    "shell-player-window",
  ]

  Overlay root_overlay {
    hexpand: true;
    vexpand: true;

    /* Base Layer: Video Stage + Optional Queue & Chapters Drawer */
    Box body_hbox {
      orientation: horizontal;
      spacing: 0;
      hexpand: true;
      vexpand: true;

      Overlay video_overlay {
        hexpand: true;
        vexpand: true;

        GLArea video_gl_area {
          hexpand: true;
          vexpand: true;
          auto-render: false;

          styles [
            "player-video-stage",
          ]
        }

        [overlay]
        Box empty_state_box {
          orientation: vertical;
          spacing: 12;
          halign: center;
          valign: center;

          Image {
            icon-name: "video-x-generic";
            pixel-size: 64;
          }

          Label {
            label: "NO MEDIA LOADED";

            styles [
              "heading",
            ]
          }

          Label {
            label: "Open a video or audio file (.mkv, .mp4, .webm, .mp3, .flac) to begin playback";

            styles [
              "shell-popover-subtitle",
            ]
          }

          Button btn_empty_open {
            label: "📂 OPEN MEDIA FILE (CTRL+O)";
            halign: center;

            styles [
              "files-accent-btn",
            ]
          }
        }

        [overlay]
        Box audio_state_box {
          orientation: vertical;
          spacing: 14;
          halign: center;
          valign: center;
          visible: false;

          styles [
            "shell-popover-card",
            "player-audio-card",
          ]

          Image {
            icon-name: "audio-x-generic";
            pixel-size: 72;
          }

          Label audio_title_label {
            label: "Audio Stream";
            wrap: true;
            max-width-chars: 42;
            justify: center;

            styles [
              "heading",
            ]
          }

          Label audio_meta_label {
            label: "AUDIO STREAM";

            styles [
              "shell-popover-badge",
            ]
          }
        }

        /* Technical Telemetry OSD Overlay (Toggled with I / Ctrl+J / ℹ STATS) */
        [overlay]
        Box stats_osd_box {
          orientation: vertical;
          spacing: 6;
          halign: start;
          valign: start;
          margin-start: 16;
          margin-top: 16;
          visible: false;
          can-target: false;

          styles [
            "shell-popover-card",
            "player-stats-osd",
          ]

          Label {
            label: "⚡ LIBMPV STREAM TELEMETRY";
            halign: start;

            styles [
              "heading",
            ]
          }

          Label stats_osd_label {
            label: "No active stream";
            halign: start;
            selectable: false;

            styles [
              "player-stats-text",
            ]
          }
        }
      }

      /* Right Toggleable Queue & Chapters Drawer (240px, Hidden by Default) */
      Box queue_vbox {
        orientation: vertical;
        spacing: 0;
        width-request: 240;
        visible: false;

        styles [
          "files-inspector-pane",
        ]

        /* Optional Chapters Section (Auto-Shown When Media Has Chapters) */
        Box chapters_card {
          orientation: vertical;
          spacing: 0;
          height-request: 180;
          visible: false;
          margin-start: 6;
          margin-end: 6;
          margin-top: 6;

          styles [
            "shell-popover-card",
          ]

          Box {
            orientation: horizontal;
            spacing: 6;

            styles [
              "shell-popover-header",
            ]

            Label {
              label: "CHAPTERS";
              halign: start;

              styles [
                "heading",
              ]
            }

            Label chapters_count_badge {
              label: "[ 0 ]";
              hexpand: true;
              halign: end;

              styles [
                "shell-popover-badge",
              ]
            }
          }

          ScrolledWindow {
            vexpand: true;
            hscrollbar-policy: never;
            vscrollbar-policy: automatic;

            ListBox chapters_listbox {
              selection-mode: single;

              styles [
                "navigation-sidebar",
              ]
            }
          }
        }

        /* Folder Queue Card */
        Box {
          orientation: vertical;
          spacing: 0;
          vexpand: true;
          margin-start: 6;
          margin-end: 6;
          margin-top: 6;
          margin-bottom: 6;

          styles [
            "shell-popover-card",
          ]

          Box {
            orientation: horizontal;
            spacing: 6;

            styles [
              "shell-popover-header",
            ]

            Label {
              label: "QUEUE";
              halign: start;

              styles [
                "heading",
              ]
            }

            Label queue_count_badge {
              label: "[ 0 ]";
              hexpand: true;
              halign: end;

              styles [
                "shell-popover-badge",
              ]
            }
          }

          ScrolledWindow {
            vexpand: true;
            hscrollbar-policy: never;
            vscrollbar-policy: automatic;

            ListBox queue_listbox {
              selection-mode: single;

              styles [
                "navigation-sidebar",
              ]
            }
          }
        }
      }
    }

    /* Overlay Zone 1: Frameless Metro Header Deck (Top) */
    [overlay]
    WindowHandle header_handle {
      valign: start;
      hexpand: true;

      Box header_bar {
        orientation: horizontal;
        spacing: 8;

        styles [
          "settings-header-bar",
          "player-header-bar",
        ]

        Label title_label {
          label: "🎬 KAJO PLAYER";
          halign: start;
          ellipsize: middle;
          valign: center;

          styles [
            "settings-header-title",
          ]
        }

        Label stream_badge {
          label: "[ IDLE ]";
          hexpand: true;
          halign: end;
          valign: center;

          styles [
            "shell-popover-badge",
          ]
        }

        Button btn_stats {
          label: "ℹ STATS";
          tooltip-text: "Toggle Technical Stream Telemetry (I / Ctrl+J)";
          valign: center;

          styles [
            "flat",
            "files-nav-btn",
          ]
        }

        Button btn_open {
          label: "📂 OPEN";
          tooltip-text: "Open Media File (Ctrl+O)";
          valign: center;

          styles [
            "flat",
            "files-nav-btn",
          ]
        }

        Button btn_queue {
          label: "☰ QUEUE";
          tooltip-text: "Toggle Queue & Chapters Drawer (Ctrl+P)";
          valign: center;

          styles [
            "flat",
            "files-nav-btn",
          ]
        }

        Button btn_float {
          label: "🗗 FLOAT / TILE";
          valign: center;

          styles [
            "flat",
          ]
        }

        Button btn_close {
          label: "✕";
          valign: center;

          styles [
            "settings-close-btn",
          ]
        }
      }
    }

    /* Overlay Zone 2: Bottom Metro Transport Deck */
    [overlay]
    Box transport_deck {
      orientation: vertical;
      spacing: 6;
      valign: end;
      hexpand: true;

      styles [
        "player-transport-deck",
      ]

      /* Row 1: Timeline Scrubber & Timecode */
      Box {
        orientation: horizontal;
        spacing: 10;
        valign: center;

        Label time_elapsed_lbl {
          label: "00:00";
          valign: center;

          styles [
            "player-timecode",
          ]
        }

        Scale seek_scale {
          orientation: horizontal;
          hexpand: true;
          draw-value: false;
          valign: center;

          styles [
            "player-seek-scale",
          ]
        }

        Label time_total_lbl {
          label: "00:00";
          valign: center;

          styles [
            "player-timecode",
          ]
        }
      }

      /* Row 2: Transport Buttons, Speed, Subtitles, Audio, Volume & Fullscreen */
      Box {
        orientation: horizontal;
        spacing: 6;
        valign: center;

        Button btn_prev {
          label: "⏮";
          tooltip-text: "Previous in Queue (PageUp)";
          valign: center;

          styles [
            "flat",
            "files-nav-btn",
          ]
        }

        Button btn_seek_back {
          label: "-10s";
          tooltip-text: "Rewind 10 Seconds (Left)";
          valign: center;

          styles [
            "flat",
            "files-nav-btn",
          ]
        }

        Button btn_play_pause {
          label: "▶ PLAY";
          tooltip-text: "Play / Pause (Space)";
          valign: center;

          styles [
            "files-accent-btn",
            "player-play-btn",
          ]
        }

        Button btn_seek_fwd {
          label: "+10s";
          tooltip-text: "Fast-Forward 10 Seconds (Right)";
          valign: center;

          styles [
            "flat",
            "files-nav-btn",
          ]
        }

        Button btn_next {
          label: "⏭";
          tooltip-text: "Next in Queue (PageDown)";
          valign: center;

          styles [
            "flat",
            "files-nav-btn",
          ]
        }

        Button btn_loop {
          label: "🔁 LOOP";
          tooltip-text: "Toggle Loop Current Track (L)";
          valign: center;

          styles [
            "flat",
            "files-nav-btn",
          ]
        }

        Label transport_status_lbl {
          label: "READY";
          hexpand: true;
          halign: center;
          valign: center;
          ellipsize: end;

          styles [
            "shell-popover-subtitle",
          ]
        }

        /* Playback Speed & Frame Step MenuButton */
        MenuButton btn_speed {
          label: "1.0×";
          tooltip-text: "Playback Speed & Frame Step ([ / ] / . / ,)";
          valign: center;
          direction: up;

          styles [
            "flat",
            "files-nav-btn",
          ]

          popover: Popover speed_popover {
            has-arrow: false;

            styles [
              "shell-popover",
            ]

            Box {
              orientation: vertical;
              spacing: 8;
              width-request: 280;

              styles [
                "shell-popover-card",
              ]

              Box {
                orientation: horizontal;

                styles [
                  "shell-popover-header",
                ]

                Label {
                  label: "SPEED & FRAME CONTROL";
                  halign: start;

                  styles [
                    "heading",
                  ]
                }

                Label speed_badge_lbl {
                  label: "[ 1.00× ]";
                  hexpand: true;
                  halign: end;

                  styles [
                    "shell-popover-badge",
                  ]
                }
              }

              Box {
                orientation: horizontal;
                spacing: 4;
                homogeneous: true;

                Button btn_spd_05 {
                  label: "0.5×";

                  styles [
                    "flat",
                    "files-nav-btn",
                  ]
                }

                Button btn_spd_075 {
                  label: "0.75×";

                  styles [
                    "flat",
                    "files-nav-btn",
                  ]
                }

                Button btn_spd_10 {
                  label: "1.0×";

                  styles [
                    "flat",
                    "files-nav-btn",
                  ]
                }

                Button btn_spd_125 {
                  label: "1.25×";

                  styles [
                    "flat",
                    "files-nav-btn",
                  ]
                }

                Button btn_spd_15 {
                  label: "1.5×";

                  styles [
                    "flat",
                    "files-nav-btn",
                  ]
                }

                Button btn_spd_20 {
                  label: "2.0×";

                  styles [
                    "flat",
                    "files-nav-btn",
                  ]
                }
              }

              Box {
                orientation: horizontal;
                spacing: 6;
                homogeneous: true;

                Button btn_frame_prev {
                  label: "⏮ -1 FRAME (,)";

                  styles [
                    "flat",
                    "files-nav-btn",
                  ]
                }

                Button btn_frame_next {
                  label: "+1 FRAME (.) ⏭";

                  styles [
                    "flat",
                    "files-nav-btn",
                  ]
                }
              }

              Button btn_ab_loop {
                label: "🔁 CYCLE A–B LOOP POINT";

                styles [
                  "flat",
                  "files-nav-btn",
                ]
              }
            }
          };
        }

        /* Subtitle Track, External .SRT/.ASS & Sync MenuButton */
        MenuButton btn_subs {
          label: "💬 SUBS";
          tooltip-text: "Subtitles, External .SRT/.ASS & Sync (J / V / Z / X)";
          valign: center;
          direction: up;

          styles [
            "flat",
            "files-nav-btn",
          ]

          popover: Popover subs_popover {
            has-arrow: false;

            styles [
              "shell-popover",
            ]

            Box {
              orientation: vertical;
              spacing: 8;
              width-request: 320;

              styles [
                "shell-popover-card",
              ]

              Box {
                orientation: horizontal;

                styles [
                  "shell-popover-header",
                ]

                Label {
                  label: "SUBTITLE STREAMS";
                  halign: start;

                  styles [
                    "heading",
                  ]
                }

                Label subs_badge_lbl {
                  label: "[ AUTO ]";
                  hexpand: true;
                  halign: end;

                  styles [
                    "shell-popover-badge",
                  ]
                }
              }

              ScrolledWindow {
                height-request: 140;
                hscrollbar-policy: never;
                vscrollbar-policy: automatic;

                ListBox subs_listbox {
                  selection-mode: single;

                  styles [
                    "navigation-sidebar",
                  ]
                }
              }

              Button btn_load_sub {
                label: "📂 LOAD EXTERNAL SUBTITLE (.SRT / .ASS)";

                styles [
                  "files-accent-btn",
                ]
              }

              /* Subtitle Timing Delay Row */
              Box {
                orientation: horizontal;
                spacing: 6;
                valign: center;

                Label {
                  label: "SYNC DELAY";
                  halign: start;
                  hexpand: true;
                  valign: center;

                  styles [
                    "shell-popover-subtitle",
                  ]
                }

                Button btn_sub_delay_dec {
                  label: "-100ms";
                  valign: center;

                  styles [
                    "flat",
                    "files-nav-btn",
                  ]
                }

                Label sub_delay_lbl {
                  label: "0 ms";
                  width-request: 58;
                  halign: center;
                  valign: center;

                  styles [
                    "player-timecode",
                  ]
                }

                Button btn_sub_delay_inc {
                  label: "+100ms";
                  valign: center;

                  styles [
                    "flat",
                    "files-nav-btn",
                  ]
                }

                Button btn_sub_delay_reset {
                  label: "RST";
                  valign: center;

                  styles [
                    "flat",
                    "files-nav-btn",
                  ]
                }
              }

              /* Subtitle Font Scale Row */
              Box {
                orientation: horizontal;
                spacing: 6;
                valign: center;

                Label {
                  label: "FONT SCALE";
                  halign: start;
                  hexpand: true;
                  valign: center;

                  styles [
                    "shell-popover-subtitle",
                  ]
                }

                Button btn_sub_scale_dec {
                  label: "-10%";
                  valign: center;

                  styles [
                    "flat",
                    "files-nav-btn",
                  ]
                }

                Label sub_scale_lbl {
                  label: "100%";
                  width-request: 58;
                  halign: center;
                  valign: center;

                  styles [
                    "player-timecode",
                  ]
                }

                Button btn_sub_scale_inc {
                  label: "+10%";
                  valign: center;

                  styles [
                    "flat",
                    "files-nav-btn",
                  ]
                }
              }
            }
          };
        }

        /* Multi-Language Audio Track & Sync MenuButton */
        MenuButton btn_audio {
          label: "🎧 AUDIO";
          tooltip-text: "Audio Streams & Sync (#)";
          valign: center;
          direction: up;

          styles [
            "flat",
            "files-nav-btn",
          ]

          popover: Popover audio_popover {
            has-arrow: false;

            styles [
              "shell-popover",
            ]

            Box {
              orientation: vertical;
              spacing: 8;
              width-request: 310;

              styles [
                "shell-popover-card",
              ]

              Box {
                orientation: horizontal;

                styles [
                  "shell-popover-header",
                ]

                Label {
                  label: "AUDIO STREAMS";
                  halign: start;

                  styles [
                    "heading",
                  ]
                }

                Label audio_badge_lbl {
                  label: "[ #1 ]";
                  hexpand: true;
                  halign: end;

                  styles [
                    "shell-popover-badge",
                  ]
                }
              }

              ScrolledWindow {
                height-request: 130;
                hscrollbar-policy: never;
                vscrollbar-policy: automatic;

                ListBox audio_listbox {
                  selection-mode: single;

                  styles [
                    "navigation-sidebar",
                  ]
                }
              }

              /* Audio Sync Delay Row */
              Box {
                orientation: horizontal;
                spacing: 6;
                valign: center;

                Label {
                  label: "AUDIO DELAY";
                  halign: start;
                  hexpand: true;
                  valign: center;

                  styles [
                    "shell-popover-subtitle",
                  ]
                }

                Button btn_audio_delay_dec {
                  label: "-100ms";
                  valign: center;

                  styles [
                    "flat",
                    "files-nav-btn",
                  ]
                }

                Label audio_delay_lbl {
                  label: "0 ms";
                  width-request: 58;
                  halign: center;
                  valign: center;

                  styles [
                    "player-timecode",
                  ]
                }

                Button btn_audio_delay_inc {
                  label: "+100ms";
                  valign: center;

                  styles [
                    "flat",
                    "files-nav-btn",
                  ]
                }

                Button btn_audio_delay_reset {
                  label: "RST";
                  valign: center;

                  styles [
                    "flat",
                    "files-nav-btn",
                  ]
                }
              }
            }
          };
        }

        Button btn_screenshot {
          label: "📷";
          tooltip-text: "Save Video Frame Screenshot to ~/Pictures (S)";
          valign: center;

          styles [
            "flat",
            "files-nav-btn",
          ]
        }

        Button btn_mute {
          label: "🔊";
          tooltip-text: "Toggle Mute (M)";
          valign: center;

          styles [
            "flat",
            "files-nav-btn",
          ]
        }

        Scale volume_scale {
          orientation: horizontal;
          width-request: 88;
          draw-value: false;
          valign: center;

          styles [
            "player-volume-scale",
          ]
        }

        Label volume_pct_lbl {
          label: "100%";
          width-request: 40;
          halign: end;
          valign: center;

          styles [
            "player-timecode",
          ]
        }

        Button btn_fullscreen {
          label: "⛶ FULL";
          tooltip-text: "Toggle Fullscreen (F / Double-Click)";
          valign: center;

          styles [
            "flat",
            "files-nav-btn",
          ]
        }
      }
    }
  }
}
