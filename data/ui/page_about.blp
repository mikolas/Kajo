using Gtk 4.0;

template $SettingsPageAbout : Box {
  orientation: vertical;
  spacing: 12;

  Box card_box {
    orientation: vertical;
    spacing: 10;

    styles [
      "section-card-left",
    ]

    Box brand_hdr_box {
      orientation: horizontal;
      spacing: 14;
      valign: center;

      Image brand_logo_img {
        icon-name: "kajo";
        pixel-size: 56;
        valign: center;
      }

      Box brand_title_vbox {
        orientation: vertical;
        spacing: 2;
        valign: center;

        Label title_label {
          label: "KAJO // OS — NATIVE WORKSPACE SUITE";
          halign: start;
          valign: center;

          styles [
            "heading",
          ]
        }

        Label subtitle_label {
          label: "Aero + Metro Personal Application Suite • C11 / GTK4 / Wayland";
          halign: start;
          valign: center;

          styles [
            "row-subtitle",
          ]
        }
      }
    }

    Label kernel_label {
      label: "Kernel: Linux";
      halign: start;
    }

    Label cpu_label {
      label: "Processor: System CPU";
      halign: start;
    }

    Label mem_label {
      label: "Memory: System RAM";
      halign: start;
    }

    Label gtk_label {
      label: "Toolkit: GTK4 + PipeWire + BlueZ5";
      halign: start;
    }

    Label niri_label {
      label: "Compositor: Niri Wayland Scrollable Tiling Compositor";
      halign: start;
    }
  }
}
