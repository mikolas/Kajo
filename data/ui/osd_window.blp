using Gtk 4.0;

template $ShellOSDWindow : Window {
  styles [
    "shell-osd",
  ]

  Box card_box {
    orientation: horizontal;
    spacing: 10;
    valign: center;
    width-request: 240;
    height-request: 48;

    styles [
      "shell-osd-card",
    ]

    Image icon_img {
      icon-name: "audio-volume-high-symbolic";
      pixel-size: 24;
      valign: center;
    }

    LevelBar level_bar {
      min-value: 0;
      max-value: 1;
      hexpand: true;
      valign: center;
    }

    Label label {
      label: "100%";
      valign: center;

      styles [
        "shell-osd-label",
      ]
    }
  }
}
