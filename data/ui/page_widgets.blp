using Gtk 4.0;

template $SettingsPageWidgets : Box {
  orientation: vertical;
  spacing: 12;

  /* Left Section Card */
  Box card_left {
    orientation: vertical;
    spacing: 8;

    styles [
      "section-card-left",
    ]

    Label lbl_left {
      label: "🔵 1. LEFT PANEL SECTION";
      halign: start;

      styles [
        "heading",
      ]
    }
  }

  /* Center Section Card */
  Box card_center {
    orientation: vertical;
    spacing: 8;

    styles [
      "section-card-center",
    ]

    Label lbl_center {
      label: "🟠 2. CENTER PANEL SECTION";
      halign: start;

      styles [
        "heading",
      ]
    }
  }

  /* Right Section Card */
  Box card_right {
    orientation: vertical;
    spacing: 8;

    styles [
      "section-card-right",
    ]

    Label lbl_right {
      label: "🟢 3. RIGHT PANEL SECTION";
      halign: start;

      styles [
        "heading",
      ]
    }
  }

  /* Add Widget Bar */
  Box add_bar {
    orientation: horizontal;
    spacing: 8;

    Label {
      label: "Add Widget";
      hexpand: true;
      halign: start;
    }

    DropDown combo_add_widget {}

    DropDown combo_add_section {}

    DropDown combo_add_mode {}

    Button btn_add {
      label: "[ + ADD WIDGET ]";

      styles [
        "flat",
      ]
    }
  }

  /* Action Button */
  Button btn_apply {
    label: "[ APPLY PANEL WIDGET LAYOUT ]";

    styles [
      "flat",
    ]
  }
}
