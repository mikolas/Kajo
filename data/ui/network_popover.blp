using Gtk 4.0;

template $ShellNetworkPopover : Popover {
  styles [
    "shell-popover",
  ]

  Box {
    orientation: vertical;

    styles [
      "popover-medium",
    ]

    /* Zone 1: Header (Title + Status Badge) */
    Box {
      orientation: horizontal;

      styles [
        "shell-popover-header",
      ]

      Label title_label {
        label: "NETWORK";
        xalign: 0;
        hexpand: true;

        styles [
          "shell-popover-title",
        ]
      }

      Label status_badge {
        label: "[ CONNECTED ]";

        styles [
          "shell-popover-badge",
        ]
      }
    }

    /* Zone 2: Body (Wi-Fi Adapter + Connection Info) */
    Box {
      orientation: vertical;
      spacing: 8;

      styles [
        "shell-popover-body",
      ]

      Box {
        orientation: horizontal;
        spacing: 8;

        Label {
          label: "Wi-Fi Adapter";
          hexpand: true;
          xalign: 0;
        }

        Switch wifi_switch {}
      }

      Label {
        label: "ACTIVE CONNECTION";
        xalign: 0;

        styles [
          "shell-popover-subtitle",
        ]
      }

      Label active_ssid_label {
        label: "Disconnected";
        xalign: 0;
      }

      Label active_ip_label {
        label: "IP: --";
        xalign: 0;
      }

      Label net_speed_label {
        label: "Speed: ⬇ 0.0 KB/s  ⬆ 0.0 KB/s";
        xalign: 0;
      }
    }

    /* Zone 3: Footer (Actions) */
    Box {
      orientation: horizontal;
      spacing: 8;

      styles [
        "shell-popover-footer",
      ]

      Button settings_btn {
        label: "NET SETTINGS";
        has-frame: false;
        halign: end;
        hexpand: true;
      }
    }
  }
}
