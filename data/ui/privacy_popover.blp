using Gtk 4.0;

template $ShellPrivacyPopover : Popover {
  styles [
    "shell-popover",
  ]

  Box {
    orientation: vertical;

    styles [
      "popover-compact",
    ]

    /* Zone 1: Header (Title + Badge) */
    Box {
      orientation: horizontal;
      valign: center;

      styles [
        "shell-popover-header",
      ]

      Label title_label {
        label: "PRIVACY INDICATORS";
        xalign: 0;
        hexpand: true;
        valign: center;

        styles [
          "shell-popover-title",
        ]
      }

      Label status_badge {
        label: "[ CLEAR ]";
        valign: center;

        styles [
          "shell-popover-badge",
        ]
      }
    }

    /* Zone 2: Body */
    Box {
      orientation: vertical;
      spacing: 8;

      styles [
        "shell-popover-body",
      ]

      /* Mic Status */
      Label mic_status_label {
        label: "Microphone: Inactive";
        xalign: 0;

        styles [
          "row-title",
        ]
      }

      /* Cam Status */
      Label cam_status_label {
        label: "Camera: Inactive";
        xalign: 0;

        styles [
          "row-title",
        ]
      }
    }

    /* Zone 3: Footer */
    Box {
      orientation: horizontal;
      spacing: 8;
      valign: center;

      styles [
        "shell-popover-footer",
      ]

      Button settings_btn {
        label: "AUDIO & INPUT SETTINGS";
        has-frame: false;
        halign: end;
        valign: center;
        hexpand: true;
      }
    }
  }
}
