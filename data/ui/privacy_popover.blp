using Gtk 4.0;

template $ShellPrivacyPopover : Popover {
  styles [
    "shell-popover",
  ]

  Box {
    orientation: vertical;

    styles [
      "popover-compact",
    ]

    /* Zone 1: Header (Title + Badge) */
    Box {
      orientation: horizontal;

      styles [
        "shell-popover-header",
      ]

      Label title_label {
        label: "PRIVACY INDICATORS";
        xalign: 0;
        hexpand: true;

        styles [
          "shell-popover-title",
        ]
      }

      Label status_badge {
        label: "[ ACTIVE ]";

        styles [
          "shell-popover-badge",
        ]
      }
    }

    /* Zone 2: Body */
    Box {
      orientation: vertical;
      spacing: 8;

      styles [
        "shell-popover-body",
      ]

      /* Mic Status */
      Label mic_status_label {
        label: "Microphone: Inactive";
        xalign: 0;
      }

      /* Cam Status */
      Label cam_status_label {
        label: "Camera: Inactive";
        xalign: 0;
      }
    }
  }
}
