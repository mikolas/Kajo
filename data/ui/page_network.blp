using Gtk 4.0;

template $SettingsPageNetwork : Box {
  orientation: vertical;
  spacing: 12;

  /* Wi-Fi Power Switch Card */
  Box {
    orientation: horizontal;
    spacing: 12;

    styles [
      "section-card-left",
    ]

    Label {
      label: "Wi-Fi Wireless Networking";
      hexpand: true;
      halign: start;

      styles [
        "heading",
      ]
    }

    Switch sw_wifi {
      active: true;
    }
  }

  /* Active Connection Card Container */
  Box card_act {
    orientation: vertical;
    spacing: 8;

    styles [
      "section-card-center",
    ]

    Label {
      label: "ACTIVE CONNECTION";
      halign: start;

      styles [
        "heading",
      ]
    }
  }

  /* Available Wi-Fi Access Points Container */
  Box card_scan {
    orientation: vertical;
    spacing: 8;

    styles [
      "section-card-right",
    ]

    Box {
      orientation: horizontal;
      spacing: 8;

      Label {
        label: "AVAILABLE WI-FI NETWORKS";
        hexpand: true;
        halign: start;

        styles [
          "heading",
        ]
      }

      Button btn_scan {
        label: "🔍 REFRESH SCAN";

        styles [
          "flat",
        ]
      }
    }

    Box list_scan {
      orientation: vertical;
      spacing: 4;
    }
  }
}
