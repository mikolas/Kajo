using Gtk 4.0;

template $SettingsPageNetwork : Box {
  orientation: vertical;
  spacing: 12;

  /* Wi-Fi Power Switch Card */
  Box {
    orientation: horizontal;
    spacing: 12;

    styles [
      "section-card-left",
    ]

    Label {
      label: "Wi-Fi Wireless Networking";
      hexpand: true;
      halign: start;

      styles [
        "heading",
      ]
    }

    Switch sw_wifi {
      active: true;
    }
  }

  /* Active Connection Card Container */
  Box {
    orientation: vertical;
    spacing: 8;

    styles [
      "section-card-center",
    ]

    Label {
      label: "ACTIVE CONNECTION";
      halign: start;

      styles [
        "heading",
      ]
    }

    Box card_act {
      orientation: vertical;
      spacing: 4;
    }
  }

  /* Available Wi-Fi Access Points Container */
  Box card_scan {
    orientation: vertical;
    spacing: 8;

    styles [
      "section-card-right",
    ]

    Box {
      orientation: horizontal;
      spacing: 8;

      Label {
        label: "AVAILABLE WI-FI NETWORKS";
        hexpand: true;
        halign: start;

        styles [
          "heading",
        ]
      }

      Button btn_scan {
        label: "🔍 REFRESH SCAN";

        styles [
          "files-nav-btn",
        ]
      }
    }

    /* Inline passphrase / status banner (gallery: .files-auth-bar pattern) */
    Revealer auth_revealer {
      reveal-child: false;
      transition-type: slide_down;

      Box {
        orientation: vertical;
        spacing: 8;

        styles [
          "settings-auth-bar",
        ]

        Label auth_title {
          label: "PASSPHRASE REQUIRED";
          halign: start;
          xalign: 0;
          wrap: true;

          styles [
            "shell-popover-badge",
            "accent",
          ]
        }

        Label auth_status {
          label: "";
          halign: start;
          xalign: 0;
          wrap: true;
          visible: false;

          styles [
            "row-subtitle",
          ]
        }

        Box auth_row {
          orientation: horizontal;
          spacing: 8;

          PasswordEntry auth_entry {
            hexpand: true;
            show-peek-icon: true;
            placeholder-text: "Wi-Fi passphrase";
          }

          Button btn_auth_connect {
            label: "CONNECT";
            valign: center;

            styles [
              "action-btn-primary",
              "files-nav-btn",
            ]
          }

          Button btn_auth_cancel {
            label: "CANCEL";
            valign: center;

            styles [
              "files-nav-btn",
            ]
          }
        }
      }
    }

    Box list_scan {
      orientation: vertical;
      spacing: 4;
    }
  }
}
