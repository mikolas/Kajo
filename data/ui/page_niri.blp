using Gtk 4.0;

template $SettingsPageNiri : Box {
  orientation: vertical;
  spacing: 16;

  /* Card 1: Layer Rules & Workspace Gaps */
  Box {
    orientation: vertical;
    spacing: 12;

    styles [
      "section-card-left",
    ]

    Label {
      label: "LAYER SURFACE RULES & GAPS";
      halign: start;

      styles [
        "settings-section-title",
      ]
    }

    /* Target Namespace Selector Row */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Target Layer Namespace:";
        width-chars: 41;
        xalign: 0;
        valign: center;
      }

      DropDown combo_ns {
        hexpand: true;
      }
    }

    /* Opacity Slider Row */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Surface Layer Opacity:";
        width-chars: 41;
        xalign: 0;
        valign: center;
      }

      Scale scale_op {
        orientation: horizontal;
        hexpand: true;

        adjustment: Adjustment {
          lower: 20;
          upper: 100;
          step-increment: 1;
        };
      }

      Label lbl_op_val {
        label: "85%";
        width-request: 64;
        xalign: 1;
        valign: center;

        styles [
          "shell-popover-badge",
        ]
      }
    }

    /* Window Gap Slider Row */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Workspace Window Gaps:";
        width-chars: 41;
        xalign: 0;
        valign: center;
      }

      Scale scale_gap {
        orientation: horizontal;
        hexpand: true;

        adjustment: Adjustment {
          lower: 0;
          upper: 32;
          step-increment: 1;
        };
      }

      Label lbl_gap_val {
        label: "12px";
        width-request: 64;
        xalign: 1;
        valign: center;

        styles [
          "shell-popover-badge",
        ]
      }
    }

    /* XRay Dropdown Row */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Blur XRay (show wallpaper through blur):";
        width-chars: 41;
        xalign: 0;
        valign: center;
        hexpand: true;
        halign: start;
      }

      Switch sw_xray {
        valign: center;
      }
    }
  }

  /* Card 2: Window Transition Shaders (GLSL) */
  Box {
    orientation: vertical;
    spacing: 12;

    styles [
      "section-card-left",
    ]

    Label {
      label: "WINDOW TRANSITION SHADERS (GLSL)";
      halign: start;

      styles [
        "settings-section-title",
      ]
    }

    /* Window Open Shader Preset */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Window Open Shader:";
        width-chars: 41;
        xalign: 0;
        valign: center;
      }

      DropDown combo_shader_open {
        hexpand: true;
      }
    }

    /* Window Open Duration & Curve */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Open Duration & Curve:";
        width-chars: 41;
        xalign: 0;
        valign: center;
      }

      Scale scale_open_dur {
        orientation: horizontal;
        hexpand: true;

        adjustment: Adjustment {
          lower: 50;
          upper: 800;
          step-increment: 10;
        };
      }

      Label lbl_open_dur_val {
        label: "150ms";
        width-request: 64;
        xalign: 1;
        valign: center;

        styles [
          "shell-popover-badge",
        ]
      }

      DropDown combo_open_curve {
      }
    }

    /* Window Close Shader Preset */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Window Close Shader:";
        width-chars: 41;
        xalign: 0;
        valign: center;
      }

      DropDown combo_shader_close {
        hexpand: true;
      }
    }

    /* Window Close Duration & Curve */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Close Duration & Curve:";
        width-chars: 41;
        xalign: 0;
        valign: center;
      }

      Scale scale_close_dur {
        orientation: horizontal;
        hexpand: true;

        adjustment: Adjustment {
          lower: 50;
          upper: 800;
          step-increment: 10;
        };
      }

      Label lbl_close_dur_val {
        label: "150ms";
        width-request: 64;
        xalign: 1;
        valign: center;

        styles [
          "shell-popover-badge",
        ]
      }

      DropDown combo_close_curve {
      }
    }

    /* Window Resize Shader Preset */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Window Resize Shader:";
        width-chars: 41;
        xalign: 0;
        valign: center;
      }

      DropDown combo_shader_resize {
        hexpand: true;
      }
    }

    /* Action Bar */
    Box {
      orientation: horizontal;
      spacing: 12;

      Button btn_apply {
        label: "[ ✓ SAVE & APPLY ]";
        hexpand: true;

        styles [
          "action-btn-primary",
        ]
      }

      Button btn_test_shader {
        label: "▶ TEST TRANSITION";

        styles [
          "files-nav-btn",
        ]
      }
    }
  }
}
