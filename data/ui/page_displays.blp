using Gtk 4.0;

template $SettingsPageDisplays : Box {
  orientation: vertical;
  spacing: 12;

  Box {
    orientation: vertical;
    spacing: 12;

    styles [
      "section-card-left",
    ]

    /* Active Monitor Information Card Header */
    Label lbl_mon_hdr {
      label: "Monitor Information";
      halign: start;

      styles [
        "heading",
      ]
    }

    /* Resolution Row */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Resolution & Refresh Rate:";
        width-chars: 37;
        xalign: 0;
        valign: center;
      }

      DropDown combo_res {
        hexpand: true;
      }
    }

    /* Orientation Row */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Display Orientation:";
        width-chars: 37;
        xalign: 0;
        valign: center;
      }

      DropDown combo_orient {
        hexpand: true;
      }
    }

    /* Scale Row */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Display Fractional Scale:";
        width-chars: 37;
        xalign: 0;
        valign: center;
      }

      DropDown combo_scale {
        hexpand: true;
      }
    }

    /* Feature Tiles Grid */
    Grid grid_features {
      column-spacing: 8;
      row-spacing: 8;
    }

    /* Apply Button */
    Button btn_apply {
      label: "[ ✓ SAVE & APPLY DISPLAY ]";

      styles [
        "action-btn-primary",
      ]
    }
  }

  /* Keyboard Backlight & Timeout Card (visible only when hardware present) */
  Box card_kbd_backlight {
    orientation: vertical;
    spacing: 12;
    visible: false;

    styles [
      "section-card-right",
    ]

    Label {
      label: "KEYBOARD BACKLIGHT & TIMEOUT";
      halign: start;

      styles [
        "heading",
      ]
    }

    Label {
      label: "Configure built-in keyboard illumination brightness and automatic turn-off timeout.";
      halign: start;

      styles [
        "dim-label",
      ]
    }

    Box {
      orientation: horizontal;
      spacing: 12;

      Label lbl_kbd_level {
        label: "Keyboard Backlight Brightness:";
        width-chars: 37;
        xalign: 0;
        valign: center;
        halign: start;
        hexpand: true;
      }

      /* A GtkSwitch (HP EC wake-on-start) or a segmented Off/Low/High group is
         placed here at runtime, depending on the backlight backend. */
      Box slot_kbd_level {
        valign: center;
      }
    }

    Box row_kbd_timeout {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Keyboard Backlight Auto-Off Timeout:";
        width-chars: 37;
        xalign: 0;
        valign: center;
        halign: start;
        hexpand: true;
      }

      Box slot_kbd_timeout {
        valign: center;
      }
    }

    Button btn_apply_kbd {
      label: "[ ✓ SAVE & APPLY KEYBOARD BACKLIGHT ]";

      styles [
        "action-btn-primary",
      ]
    }
  }

  /* 360° Foldable Posture & Sensors Card (visible only when hinge/accel sensors present) */
  Box card_posture {
    orientation: vertical;
    spacing: 12;
    visible: false;

    styles [
      "section-card-left",
    ]

    Label {
      label: "360° FOLDABLE POSTURE & SENSORS";
      halign: start;

      styles [
        "heading",
      ]
    }

    Label lbl_sensor_status {
      label: "Foldable hinge & orientation sensors active.";
      halign: start;

      styles [
        "dim-label",
      ]
    }

    Box row_posture_autorotate {
      orientation: horizontal;
      spacing: 12;

      Box {
        orientation: vertical;
        spacing: 2;
        hexpand: true;

        Label {
          label: "Auto-Rotate Display in Tablet / Tent Mode";
          halign: start;
        }

        Label {
          label: "Rotate built-in display using the accelerometer when folded >= 180° (locks to 0° in Laptop mode)";
          halign: start;

          styles [
            "dim-label",
          ]
        }
      }

      Switch sw_posture_autorotate {
        valign: center;
      }
    }

    Box row_posture_disable_kbd {
      orientation: horizontal;
      spacing: 12;

      Box {
        orientation: vertical;
        spacing: 2;
        hexpand: true;

        Label {
          label: "Disable Keyboard & Touchpad in Tablet Mode";
          halign: start;
        }

        Label {
          label: "Inhibit built-in keyboard and touchpad input and turn off keyboard backlight when folded >= 180°";
          halign: start;

          styles [
            "dim-label",
          ]
        }
      }

      Switch sw_posture_disable_kbd {
        valign: center;
      }
    }

    Box row_posture_disable_touch {
      orientation: horizontal;
      spacing: 12;

      Box {
        orientation: vertical;
        spacing: 2;
        hexpand: true;

        Label {
          label: "Disable Touchscreen in Laptop Mode";
          halign: start;
        }

        Label {
          label: "Inhibit finger touch in Laptop mode (<= 168°) while keeping active pen / stylus enabled";
          halign: start;

          styles [
            "dim-label",
          ]
        }
      }

      Switch sw_posture_disable_touch {
        valign: center;
      }
    }

    Button btn_apply_posture {
      label: "[ ✓ SAVE & APPLY 360° POSTURE ]";

      styles [
        "action-btn-primary",
      ]
    }
  }

  /* Screen Saver & Session Lock Card */
  Box {
    orientation: vertical;
    spacing: 12;

    styles [
      "section-card-center",
    ]

    Label {
      label: "SCREEN SAVER & SESSION LOCK";
      halign: start;

      styles [
        "heading",
      ]
    }

    Label {
      label: "Configure idle screen blanking, Metro clock screen saver, and PAM session lock.";
      halign: start;

      styles [
        "dim-label",
      ]
    }

    /* Screen Saver Mode Row */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Screen Saver Mode:";
        width-chars: 37;
        xalign: 0;
        valign: center;
        halign: start;
        hexpand: true;
      }

      DropDown combo_ss_mode {}
    }

    /* Screen Saver Timeout Row */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Screen Saver Timeout:";
        width-chars: 37;
        xalign: 0;
        valign: center;
        halign: start;
        hexpand: true;
      }

      DropDown combo_ss_timeout {}
    }

    /* DPMS Timeout Row */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Monitor Power-Off (DPMS) Timeout:";
        width-chars: 37;
        xalign: 0;
        valign: center;
        halign: start;
        hexpand: true;
      }

      DropDown combo_dpms_timeout {}
    }

    /* Auto-Lock Timeout Row */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Automatic Session Lock Timeout:";
        width-chars: 37;
        xalign: 0;
        valign: center;
        halign: start;
        hexpand: true;
      }

      DropDown combo_lock_timeout {}
    }

    /* Lock on Suspend Switch Row */
    Box {
      orientation: horizontal;
      spacing: 12;

      Box {
        orientation: vertical;
        spacing: 2;
        hexpand: true;

        Label {
          label: "Lock Session on System Suspend";
          halign: start;
        }

        Label {
          label: "Automatically lock the session before entering sleep or closing the lid";
          halign: start;

          styles [
            "dim-label",
          ]
        }
      }

      Switch sw_lock_suspend {
        valign: center;
      }
    }

    /* Action Buttons Row */
    Box {
      orientation: horizontal;
      spacing: 8;
      homogeneous: true;

      Button btn_preview_ss {
        label: "🖥 PREVIEW SCREEN SAVER";

        styles [
          "files-nav-btn",
        ]
      }

      Button btn_lock_now {
        label: "🔒 LOCK SCREEN NOW";

        styles [
          "files-nav-btn",
        ]
      }
    }

    Button btn_apply_idle {
      label: "[ ✓ SAVE & APPLY SCREEN SAVER & LOCK ]";

      styles [
        "action-btn-primary",
      ]
    }
  }
}
