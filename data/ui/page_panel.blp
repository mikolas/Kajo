using Gtk 4.0;

template $SettingsPagePanel : Box {
  orientation: vertical;
  spacing: 12;

  Box {
    orientation: vertical;
    spacing: 12;

    styles [
      "section-card-left",
    ]

    /* Position Row */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Panel Edge Position:";
        width-chars: 28;
        xalign: 0;
        valign: center;
        hexpand: true;
        halign: start;
      }

      /* Segmented Top | Bottom group is placed here at runtime. */
      Box slot_pos {
        valign: center;
      }
    }

    /* Feature toggle card (Autohide) */
    Grid toggle_grid {
      column-spacing: 8;
      row-spacing: 8;
    }

    /* Thickness Scale Slider Row */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Panel Thickness:";
        width-chars: 28;
        xalign: 0;
        valign: center;
      }

      Scale scale_height {
        orientation: horizontal;
        hexpand: true;

        adjustment: Adjustment {
          lower: 24;
          upper: 56;
          step-increment: 1;
        };
      }

      Label lbl_height_val {
        label: "32px";
        width-request: 64;
        xalign: 1;
        valign: center;

        styles [
          "shell-popover-badge",
        ]
      }
    }

    /* Reveal Delay Slider Row */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Autohide Reveal Delay:";
        width-chars: 28;
        xalign: 0;
        valign: center;
      }

      Scale scale_rev {
        orientation: horizontal;
        hexpand: true;

        adjustment: Adjustment {
          lower: 50;
          upper: 500;
          step-increment: 25;
        };
      }

      Label lbl_rev_val {
        label: "150ms";
        width-request: 64;
        xalign: 1;
        valign: center;

        styles [
          "shell-popover-badge",
        ]
      }
    }
  }

  /* Card 2: Touchscreen & Swipe Gestures */
  Box {
    orientation: vertical;
    spacing: 12;

    styles [
      "section-card-left",
    ]

    Label {
      label: "TOUCHSCREEN & SWIPE GESTURES";
      halign: start;

      styles [
        "shell-popover-section-title",
      ]
    }

    /* Enable Touch Gestures Row */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Panel Touch & Edge Swipes:";
        width-chars: 28;
        xalign: 0;
        valign: center;
        halign: start;
        hexpand: true;
      }

      Switch sw_touch_enabled {
        valign: center;
      }
    }

    /* Center / Left Edge Swipe Action */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Center / Left Inward Swipe:";
        width-chars: 28;
        xalign: 0;
        valign: center;
        halign: start;
      }

      DropDown combo_swipe_center {
        hexpand: true;
      }
    }

    /* Right Edge Swipe Action */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Right Zone Inward Swipe:";
        width-chars: 28;
        xalign: 0;
        valign: center;
        halign: start;
      }

      DropDown combo_swipe_right {
        hexpand: true;
      }
    }

    /* Horizontal Panel Swipe Action */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Horizontal Panel Swipe:";
        width-chars: 28;
        xalign: 0;
        valign: center;
        halign: start;
      }

      DropDown combo_swipe_horiz {
        hexpand: true;
      }
    }

    /* Touch Dwell Duration Slider */
    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Autohide Touch Dwell Time:";
        width-chars: 28;
        xalign: 0;
        valign: center;
        halign: start;
      }

      Scale scale_touch_dwell {
        orientation: horizontal;
        hexpand: true;

        adjustment: Adjustment {
          lower: 1000;
          upper: 8000;
          step-increment: 500;
        };
      }

      Label lbl_touch_dwell_val {
        label: "4000ms";
        width-request: 64;
        xalign: 1;
        valign: center;

        styles [
          "shell-popover-badge",
        ]
      }
    }

    Label {
      label: "VIRTUAL KEYBOARD (ON-SCREEN KEYBOARD)";
      halign: start;
      margin-top: 8;

      styles [
        "shell-popover-section-title",
      ]
    }

    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Auto-Show Virtual Keyboard:";
        width-chars: 28;
        xalign: 0;
        valign: center;
        halign: start;
      }

      DropDown combo_osk_mode {
        hexpand: true;
      }
    }

    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Window Layout Behavior:";
        width-chars: 28;
        xalign: 0;
        valign: center;
        halign: start;
      }

      /* Segmented "Push windows | Float over" group is placed here at runtime. */
      Box slot_osk_push {
        valign: center;
        hexpand: true;
        halign: end;
      }
    }

    Box {
      orientation: horizontal;
      spacing: 12;

      Label {
        label: "Virtual Keyboard Height:";
        width-chars: 28;
        xalign: 0;
        valign: center;
        halign: start;
      }

      Scale scale_osk_height {
        orientation: horizontal;
        hexpand: true;

        adjustment: Adjustment {
          lower: 180;
          upper: 420;
          step-increment: 10;
        };
      }

      Label lbl_osk_height_val {
        label: "260px";
        width-request: 64;
        xalign: 1;
        valign: center;

        styles [
          "shell-popover-badge",
        ]
      }
    }

    /* Action Row */
    Button btn_apply {
      label: "[ ✓ SAVE & APPLY ]";

      styles [
        "action-btn-primary",
      ]
    }
  }
}
